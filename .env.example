# ------------------------------------------------------------
# متغيرات البيئة على Vercel
# تُضاف من: Vercel → Project → Settings → Environment Variables
# ------------------------------------------------------------

# كلمة مرور لوحة التحكم (مطلوب)
ADMIN_PASSWORD=

# مفتاح توقيع جلسات الدخول (اختياري، يفضل نص عشوائي طويل)
AUTH_SECRET=

# تُضاف تلقائيًا عند ربط Upstash Redis من Vercel → Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=

# تُضاف تلقائيًا عند إنشاء Blob Store من Vercel → Storage
BLOB_READ_WRITE_TOKEN=
